PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_uri_here
JWT_SECRET=your_jwt_secret_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
FRONTEND_URL=http://localhost:8080
SERVE_STATIC=true

# Security (Milestone 6, E1): CORS allow-list + CSRF double-submit token.
# Origins must be listed EXACTLY (no `*.vercel.app` / `*.onrender.com`
# wildcards — anyone can create a subdomain on those hosts, so they were
# removed as an attack channel). FRONTEND_URL accepts a comma-separated list;
# add short-lived Vercel preview domains here when you need them.
# ALLOWED_EXTRA_ORIGINS — extra exact origins beyond FRONTEND_URL, comma-separated
ALLOWED_EXTRA_ORIGINS=

# Collaboration (Milestone 6, sprint E2)
TRIP_MAX_MEMBERS=25            # hard cap on members per trip (incl. the owner)
INVITE_TTL_HOURS=168           # default invite lifetime (168h = 1 week); max 720h
INVITE_DEFAULT_MAX_USES=1      # default uses per link invite (email invites are always 1)

# Live tier (Milestone 6, sprint E4 — optional, off by default)
ENABLE_TRIP_SSE=false          # true enables the SSE presence stream (+ heartbeat route)
PRESENCE_TTL_MS=30000          # presence entry TTL — clients heartbeat at ≥2x this rate

# Version history (Milestone 6, sprint E5 / flaw F13)
VERSIONS_MAX=30                # version snapshots retained per trip (each stores a full itinerary)

# AI generation cache (optional — Milestone 2)
AI_CACHE_TTL_MS=21600000
AI_CACHE_MAX=200

# Geo routing (optional — Milestone 4). haversine | osrm
GEO_ROUTING_PROVIDER=haversine
OSRM_BASE_URL=https://router.project-osrm.org

# Map tiles (optional). Keyless OpenStreetMap / Esri by default (zero watermark, no key required).
# Optional: get a free CARTO key (5M requests/mo) at https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=

# Currency rates (optional — Milestone 5). Frankfurter by default (no API key)
CURRENCY_RATES_PROVIDER=frankfurter
CURRENCY_CACHE_TTL_MS=43200000

# Weather advisories (optional — Milestone 4). Open-Meteo by default (no API key).
# Forecasts cover ~16 days; further-out dates fall back to seasonal normals.
OPEN_METEO_BASE=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_MS=2700000

# Nearby search (optional — Milestone 4). Three providers are chained, first success wins:
#   1. Geoapify (when GEOAPIFY_API_KEY is set) — reliable, covers every category, 3,000 free
#      requests/day, no credit card: https://myprojects.geoapify.com
#   2. Overpass/OpenStreetMap — keyless, richest tags, but volunteer-run and often overloaded.
#   3. Nominatim/OpenStreetMap — keyless last resort (thin coverage for some categories).
# Set OVERPASS_ENDPOINTS (comma-separated) to replace the built-in mirrors entirely, e.g. to
# point at your own or a regional instance. When every provider fails the API answers
# `available: false` instead of an empty list, and that coordinate is not retried for
# NEARBY_RETRY_AFTER_MS.
GEOAPIFY_API_KEY=
GEOAPIFY_TIMEOUT_MS=8000
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_TIMEOUT_MS=6000
OVERPASS_BUDGET_MS=10000
NOMINATIM_BASE=https://nominatim.openstreetmap.org/search
NOMINATIM_TIMEOUT_MS=10000
NOMINATIM_MIN_INTERVAL_MS=1100
NEARBY_BUDGET_MS=15000
NEARBY_CACHE_TTL_MS=86400000
NEARBY_RETRY_AFTER_MS=60000
# Deprecated: a single Overpass endpoint. Still honoured — it is tried first, with the built-in
# mirrors kept as fallbacks. Prefer OVERPASS_ENDPOINTS above.
# OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Receipt uploads (Milestone 5)
# Option A: Cloudinary CDN (Recommended for production: Render / Vercel / Railway)
# You can provide CLOUDINARY_URL or the 3 individual credentials:
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Folder receipts are uploaded into (default: travelai/receipts)
CLOUDINARY_FOLDER=travelai/receipts

# Option B: Local disk storage (automatic fallback when Cloudinary is unset)
# UPLOAD_DIR defaults to <backend>/uploads when unset; receipts are served from /uploads.
UPLOAD_DIR=
MAX_UPLOAD_MB=5
